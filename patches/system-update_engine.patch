+// Included only by update_engine_sideload, never by Android's OTA daemon.
+bool SameAbl(int source, int target, uint64_t size, bool* same) {
+  std::array<char, 65536> src, dst;
+  *same = true;
+  for (uint64_t offset = 0; offset < size;) {
+    const size_t len = std::min<uint64_t>(src.size(), size - offset);
+    if (!android::base::ReadFullyAtOffset(source, src.data(), len, offset) ||
+        !android::base::ReadFullyAtOffset(target, dst.data(), len, offset)) {
+      return false;
+    }
+    if (memcmp(src.data(), dst.data(), len) != 0) {
+      *same = false;
+      return true;
+    }
+    offset += len;
+  }
+  return true;
+}
+
+bool RestoreTargetAbl(BootControlInterface* boot, const InstallPlan& plan) {
+  std::string source_path, target_path;
+  bool source_dynamic = false, target_dynamic = false;
+  if (plan.source_slot != boot->GetCurrentSlot() ||
+      plan.source_slot == plan.target_slot ||
+      plan.source_slot >= boot->GetNumSlots() ||
+      plan.target_slot >= boot->GetNumSlots() ||
+      !boot->GetPartitionDevice("abl", plan.source_slot, false, &source_path,
+                                &source_dynamic) ||
+      !boot->GetPartitionDevice("abl", plan.target_slot, false, &target_path,
+                                &target_dynamic) ||
+      source_dynamic || target_dynamic) {
+    LOG(ERROR) << "Unable to resolve distinct physical source and target ABLs";
+    return false;
+  }
+  using android::base::unique_fd;
+  unique_fd source(open(source_path.c_str(), O_RDONLY | O_CLOEXEC));
+  unique_fd target(open(target_path.c_str(), O_RDONLY | O_CLOEXEC));
+  struct stat src_stat {}, dst_stat {};
+  uint64_t size = 0, target_size = 0;
+  if (fstat(source.get(), &src_stat) || fstat(target.get(), &dst_stat) ||
+      !S_ISBLK(src_stat.st_mode) || !S_ISBLK(dst_stat.st_mode) ||
+      src_stat.st_rdev == dst_stat.st_rdev ||
+      ioctl(source.get(), BLKGETSIZE64, &size) ||
+      ioctl(target.get(), BLKGETSIZE64, &target_size) ||
+      !size || size != target_size) {
+    LOG(ERROR) << "Invalid physical ABL pair";
+    return false;
+  }
+  bool same;
+  if (!SameAbl(source.get(), target.get(), size, &same)) {
+    PLOG(ERROR) << "Unable to compare ABLs";
+    return false;
+  }
+  if (same) {
+    LOG(INFO) << "Target ABL already matches the running slot";
+    return true;
+  }
+  int readonly = 0, writable = 0;
+  if (ioctl(target.get(), BLKROGET, &readonly) ||
+      (readonly && ioctl(target.get(), BLKROSET, &writable))) {
+    PLOG(ERROR) << "Unable to make target ABL writable";
+    return false;
+  }
+  unique_fd writer(open(target_path.c_str(), O_WRONLY | O_CLOEXEC));
+  struct stat writer_stat {};
+  if (fstat(writer.get(), &writer_stat) || !S_ISBLK(writer_stat.st_mode) ||
+      writer_stat.st_rdev != dst_stat.st_rdev) {
+    PLOG(ERROR) << "Unable to open target ABL for restoration";
+    return false;
+  }
+  std::array<char, 65536> buf;
+  for (uint64_t offset = 0; offset < size;) {
+    const size_t len = std::min<uint64_t>(buf.size(), size - offset);
+    if (!android::base::ReadFullyAtOffset(source, buf.data(), len, offset) ||
+        !android::base::WriteFully(writer, buf.data(), len)) {
+      PLOG(ERROR) << "Unable to restore target ABL";
+      return false;
+    }
+    offset += len;
+  }
+  if (TEMP_FAILURE_RETRY(fsync(writer.get())) ||
+      !SameAbl(source.get(), target.get(), size, &same) || !same) {
+    LOG(ERROR) << "Target ABL readback failed";
+    return false;
+  }
+  LOG(INFO) << "Restored and verified target ABL from the running slot";
+  return true;
+}
