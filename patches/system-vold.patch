+void CopySqliteDbForRecovery() {
+	sqlite3 *src = nullptr, *dst = nullptr;
+	int rc = sqlite3_open_v2("/data/misc/keystore/persistent.sqlite",
+	                         &src, SQLITE_OPEN_READONLY, nullptr);
+	if (rc == SQLITE_OK)
+		rc = sqlite3_open_v2("/tmp/misc/keystore/persistent.sqlite", &dst,
+		                     SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, nullptr);
+	if (rc == SQLITE_OK) {
+		sqlite3_backup *backup = sqlite3_backup_init(dst, "main", src, "main");
+		if (backup) {
+			for (int attempt = 0; attempt < 20; ++attempt) {
+				rc = sqlite3_backup_step(backup, -1);
+				if (rc != SQLITE_BUSY && rc != SQLITE_LOCKED) break;
+				usleep(50000);
+			}
+			int finish = sqlite3_backup_finish(backup);
+			if (rc == SQLITE_DONE) rc = finish;
+		} else {
+			rc = sqlite3_errcode(dst);
+		}
+	}
+	if (dst) sqlite3_close(dst);
+	if (src) sqlite3_close(src);
+	if (rc != SQLITE_OK) printf("Unable to copy keystore database: SQLite %d\n", rc);
+}
