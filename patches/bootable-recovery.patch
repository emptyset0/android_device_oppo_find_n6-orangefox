+    if (inner->modes[i].type & DRM_MODE_TYPE_PREFERRED) { mode = inner->modes[i]; break; }
+  }
+  const uint32_t mixers = get_topology_lm_number(fd, read_object_property(
+      fd, inner->connector_id, DRM_MODE_OBJECT_CONNECTOR, "mode_properties", 0));
+  const auto candidates = scanout_candidates(fd, resources, crtc);
+  if (!mixers || mixers > NUM_PLANES || candidates.size() < mixers) {
+    drmModeFreeConnector(inner);
+    return false;
+  }
+  auto* black = drm_create_surface(mode.hdisplay, mode.vdisplay);
+  uint32_t blob = 0;
+  bool ok = black && !drmModeCreatePropertyBlob(fd, &mode, sizeof(mode), &blob);
+  if (ok) memset(black->base.data, 0, black->base.height * black->base.row_bytes);
+  auto make_request = [&](bool enable, const uint32_t* pipes, uint32_t count) {
+    auto* req = drmModeAtomicAlloc();
+    if (!req) return req;
+    bool good = true;
+    auto add = [&](uint32_t id, uint32_t type, const char* name, uint64_t v) {
+      uint32_t prop = probe_object_property(fd, id, type, name);
+      if (!prop || drmModeAtomicAddProperty(req, id, prop, v) < 0) good = false;
+    };
