+
+// Object IDs are allocated by the running DRM driver. Rank planes already
+// routed to this CRTC first, then free planes; never borrow a plane visibly
+// bound to the other panel. An unbound plane can still be reserved by SDE's
+// private splash state, so the caller must atomically test the full route.
+static uint64_t read_object_property(int fd, uint32_t id, uint32_t type, const char* name,
+                                     uint64_t fallback);
+
+static std::vector<uint32_t> scanout_candidates(int fd, drmModeRes* resources, uint32_t crtc) {
+  std::vector<uint32_t> bound, free;
+  uint32_t mask = 0;
+  for (int i = 0; i < resources->count_crtcs && i < 32; ++i)
+    if (resources->crtcs[i] == crtc) mask = 1U << i;
+  auto* list = drmModeGetPlaneResources(fd);
+  if (!list) return bound;
+  for (uint32_t i = 0; i < list->count_planes; ++i) {
+    auto* p = drmModeGetPlane(fd, list->planes[i]);
+    if (!p) continue;
+    const uint64_t type = read_object_property(fd, p->plane_id, DRM_MODE_OBJECT_PLANE, "type", 0);
+    if ((p->possible_crtcs & mask) && type != DRM_PLANE_TYPE_CURSOR) {
+      if (p->crtc_id == crtc) bound.push_back(p->plane_id);
+      else if (!p->crtc_id) free.push_back(p->plane_id);
+    }
+    drmModeFreePlane(p);
+  }
+  drmModeFreePlaneResources(list);
+  bound.insert(bound.end(), free.begin(), free.end());
+  return bound;
+}
+
+template <typename Try>
+static bool try_plane_combinations(const std::vector<uint32_t>& ids, uint32_t count,
+                                   std::array<uint32_t, NUM_PLANES>& chosen,
+                                   uint32_t depth, size_t first, const Try& test) {
+  if (depth == count) return test(chosen.data(), count);
+  for (size_t i = first; i + count - depth <= ids.size(); ++i) {
+    chosen[depth] = ids[i];
+    if (try_plane_combinations(ids, count, chosen, depth + 1, i + 1, test)) return true;
+  }
+  return false;
+}
+
+static uint64_t read_object_property(int fd, uint32_t id, uint32_t type, const char* name,
+                                     uint64_t fallback) {
+  auto* props = drmModeObjectGetProperties(fd, id, type);
+  if (!props) return fallback;
+  for (uint32_t i = 0; i < props->count_props; ++i) {
+    auto* p = drmModeGetProperty(fd, props->props[i]);
+    if (!p) continue;
+    const bool match = !strcmp(p->name, name);
+    drmModeFreeProperty(p);
+    if (match) { fallback = props->prop_values[i]; break; }
+  }
+  drmModeFreeObjectProperties(props);
+  return fallback;
+}
