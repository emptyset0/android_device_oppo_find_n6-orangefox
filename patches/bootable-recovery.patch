+unsigned TWFunc::Apply_Balanced_Governor() {
+  const std::string root = "/sys/devices/system/cpu/cpufreq";
+  const std::string governor = Get_Balanced_Governor();
+  unsigned applied = 0;
+  DIR* dir = opendir(root.c_str());
+  if (!dir)
+    return applied;
+  while (const auto* entry = readdir(dir)) {
+    const std::string policy(entry->d_name);
+    if (policy.compare(0, 6, "policy") != 0 || policy.size() == 6 ||
+        policy.find_first_not_of("0123456789", 6) != std::string::npos)
+      continue;
+    const std::string path = root + "/" + policy;
+    if (!CheckWord(path + "/scaling_available_governors", governor))
+      continue;
+    const std::string setting = path + "/scaling_governor";
+    if (!CheckWord(setting, governor))
+      write_to_file(setting, governor);
+    if (CheckWord(setting, governor))
+      ++applied;
+  }
+  closedir(dir);
+  return applied;
+}
