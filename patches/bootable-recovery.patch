+// Clear unselected state in the same transaction as the new scanout. A
+// rejected route must not detach the current display during candidate trials.
+static bool append_boot_display_cleanup(int fd, drmModeRes* resources, drmModeAtomicReqPtr req,
+                                       const uint32_t* keep, uint32_t count) {
+  bool valid = true;
+  auto clear = [&](uint32_t object, uint32_t type, const char* name) {
+    uint32_t prop = probe_object_property(fd, object, type, name);
+    if (!prop || drmModeAtomicAddProperty(req, object, prop, 0) < 0) valid = false;
+  };
+  auto* planes = drmModeGetPlaneResources(fd);
+  if (!planes) return false;
+  for (uint32_t i = 0; i < planes->count_planes; ++i) {
+    uint32_t id = planes->planes[i];
+    if (std::find(keep, keep + count, id) != keep + count) continue;
+    clear(id, DRM_MODE_OBJECT_PLANE, "FB_ID");
+    clear(id, DRM_MODE_OBJECT_PLANE, "CRTC_ID");
+  }
+  drmModeFreePlaneResources(planes);
+  for (int i = 0; i < resources->count_connectors; ++i)
+    if (resources->connectors[i] != main_monitor_connector->connector_id)
+      clear(resources->connectors[i], DRM_MODE_OBJECT_CONNECTOR, "CRTC_ID");
+  for (int i = 0; i < resources->count_crtcs; ++i) {
+    if (resources->crtcs[i] == main_monitor_crtc->crtc_id) continue;
+    clear(resources->crtcs[i], DRM_MODE_OBJECT_CRTC, "ACTIVE");
+    clear(resources->crtcs[i], DRM_MODE_OBJECT_CRTC, "MODE_ID");
+  }
+  return valid;
