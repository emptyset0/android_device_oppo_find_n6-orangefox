+// A disconnected atomic connector can still be showing bootloader GRAM.
+// Reattach the inner panel to its original CRTC with a black framebuffer
+// before disabling it through the normal bridge/panel shutdown sequence.
+// Never draw Fox or enable inner touch in this path.
+static bool retire_inner_splash(int fd, drmModeRes* resources) {
+  if (main_monitor_connector->connector_type_id != 2) return true;
+  if (resources->count_crtcs < 2) return false;
+  drmModeConnector* inner = nullptr;
+  for (int i = 0; i < resources->count_connectors; ++i) {
