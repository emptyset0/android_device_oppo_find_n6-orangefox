+    add(crtc, DRM_MODE_OBJECT_CRTC, "MODE_ID", enable ? blob : 0);
+    add(crtc, DRM_MODE_OBJECT_CRTC, "ACTIVE", enable);
+    for (uint32_t i = 0; i < count; ++i) {
+      const uint32_t x = uint32_t(mode.hdisplay) * i / count;
+      const uint32_t w = uint32_t(mode.hdisplay) * (i + 1) / count - x;
+      const uint32_t p = pipes[i], t = DRM_MODE_OBJECT_PLANE;
+      add(p, t, "FB_ID", enable ? black->fb_id : 0);
+      add(p, t, "CRTC_ID", enable ? crtc : 0);
+      if (!enable) continue;
+      add(p, t, "CRTC_X", x);
+      add(p, t, "CRTC_Y", 0);
+      add(p, t, "CRTC_W", w);
+      add(p, t, "CRTC_H", mode.vdisplay);
+      add(p, t, "SRC_X", x<<16);
+      add(p, t, "SRC_Y", 0);
+      add(p, t, "SRC_W", w<<16);
+      add(p, t, "SRC_H", uint32_t(mode.vdisplay)<<16);
+    }
+    if (!good) { drmModeAtomicFree(req); return static_cast<drmModeAtomicReqPtr>(nullptr); }
+    return req;
+  };
+  if (ok) {
+    const uint32_t flags = DRM_MODE_ATOMIC_ALLOW_MODESET;
+    std::array<uint32_t, NUM_PLANES> chosen{};
+    auto* on = static_cast<drmModeAtomicReqPtr>(nullptr);
+    ok = try_plane_combinations(candidates, mixers, chosen, 0, 0,
+        [&](const uint32_t* pipes, uint32_t count) {
+          on = make_request(true, pipes, count);
+          if (on && !drmModeAtomicCommit(fd, on, flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr))
