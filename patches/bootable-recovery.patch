+  uint32_t dpms = DRM_MODE_DPMS_ON;
+  for (int i = 0; i < inner->count_props; ++i) {
+    auto* p = drmModeGetProperty(fd, inner->props[i]);
+    if (!p) continue;
+    if (!strcmp(p->name, "DPMS")) dpms = inner->prop_values[i];
+    drmModeFreeProperty(p);
