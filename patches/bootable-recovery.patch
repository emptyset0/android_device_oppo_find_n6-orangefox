+// This session lasts only until Fox exits; a crash closes the decision channel
+// without authorizing activation. The same updater keeps its install plan.
+namespace {
+constexpr char kN6OtaPending[] = "/tmp/n6_ota_pending";
+std::mutex n6_ota_mutex;
+pid_t n6_ota_pid = -1;
+android::base::unique_fd n6_ota_activation;
+FILE* n6_ota_status = nullptr;
+
+bool TakeN6OtaSession(pid_t pid, android::base::unique_fd& activation, FILE* status) {
+	std::lock_guard<std::mutex> lock(n6_ota_mutex);
+	if (n6_ota_pid > 0)
+		return false;
+	// ADB's regular reboot service uses this marker to route to Fox.
+	android::base::unique_fd marker(open(kN6OtaPending,
+	                                      O_CREAT | O_WRONLY | O_CLOEXEC | O_NOFOLLOW,
+	                                      0644));
+	if (!marker.ok())
+		return false;
+	n6_ota_pid = pid;
+	n6_ota_activation = std::move(activation);
+	n6_ota_status = status;
+	return true;
+}
+}
+
+bool N6HasPendingOta() {
+	std::lock_guard<std::mutex> lock(n6_ota_mutex);
+	return n6_ota_pid > 0;
+}
+
+bool N6CommitPendingOta() {
+	std::lock_guard<std::mutex> lock(n6_ota_mutex);
+	if (n6_ota_pid <= 0) {
+		unlink(kN6OtaPending); // a restarted Fox cannot inherit a verified session
+		return true;
+	}
+	gui_msg("n6_ota_committing=Applying the pending OTA before reboot...");
+	const char command = 'C';
+	const bool sent = TEMP_FAILURE_RETRY(
+	    send(n6_ota_activation.get(), &command, 1, MSG_NOSIGNAL)) == 1;
+	n6_ota_activation.reset();
+	char line[1024];
+	while (fgets(line, sizeof(line), n6_ota_status)) {
+		if (strncmp(line, "ui_print ", 9) == 0)
+			gui_print("%s", line + 9);
+	}
+	fclose(n6_ota_status);
+	n6_ota_status = nullptr;
+	int status = -1;
+	const auto pid = TEMP_FAILURE_RETRY(waitpid(n6_ota_pid, &status, 0));
+	const bool ok = sent && pid == n6_ota_pid && WIFEXITED(status) &&
+	                WEXITSTATUS(status) == 0;
+	n6_ota_pid = -1;
+	unlink(kN6OtaPending);
+	if (!ok)
+		gui_err("n6_ota_commit_failed=OTA activation failed; reboot cancelled.");
+	return ok;
+}
