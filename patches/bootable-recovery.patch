+    if (!ret) {
+      printf("PLP110 inner splash: black takeover committed\n");
+      ret = drmModeAtomicCommit(fd, off, flags, nullptr);
+    }
+    if (on) drmModeAtomicFree(on);
+    if (off) drmModeAtomicFree(off);
+    ok = !ret;
+    if (!ok) printf("PLP110 inner splash handoff failed rc=%d\n", ret);
+  }
+  if (blob) drmModeDestroyPropertyBlob(fd, blob);
+  drm_destroy_surface(black);
+  drmModeFreeConnector(inner);
+  if (ok) printf("PLP110 inner splash: disable committed\n");
+  return ok;
+}
