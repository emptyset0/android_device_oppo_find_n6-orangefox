+static uint32_t probe_object_property(int fd, uint32_t id, uint32_t type, const char* name) {
+  drmModeObjectProperties* props = drmModeObjectGetProperties(fd, id, type);
+  if (!props) return 0;
+  uint32_t result = 0;
+  for (uint32_t n = 0; n < props->count_props; ++n) {
+    drmModePropertyRes* prop = drmModeGetProperty(fd, props->props[n]);
+    if (prop) {
+      if (!strcmp(prop->name, name)) result = prop->prop_id;
+      drmModeFreeProperty(prop);
+    }
+    if (result) break;
+  }
+  drmModeFreeObjectProperties(props);
+  return result;
