# Start the N6 OEM AIDL HAL at the same QSEE-ready point used on X9U.
on property:sys.plp110.qsee=ready
    start vendor.oplus.vibrator

service vendor.oplus.vibrator /system/bin/linker64 /odm/bin/hw/vendor.oplus.hardware.vibrator-service
    class late_start
    disabled
    user root
    group root input
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/lib64:/odm/lib64:/vendor/lib64
    setenv RICHTAP_DEVICE_PATH /dev/awinic_haptic
    setenv ENV_RICHTAP_CONFIG_PATH /odm/etc/aac_richtap.config
