on init
    write /sys/class/backlight/panel0-backlight/brightness 0
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# Fixed outer display. Inner display/native touch fixes are opt-in at GUI startup.
on init
    setprop vendor.recovery.inner.enable 0

on boot
    start plp110-hbp5

# Noncritical: bridge failure must not reboot the phone or stop root ADB.
service plp110-hbp5 /system/bin/plp110-hbp5 --serve
    class default
    disabled
    user root
    group root input system
    seclabel u:r:recovery:s0
    restart_period 5

# Init may kill the process group before the supervisor's normal cleanup runs.
# Ensure a stopped/restarting bridge cannot leave unhandled touch IRQs running.
on property:init.svc.plp110-hbp5=stopped
    write /sys/devices/platform/soc/soc:hbp@0/irq_enable 0,0
    write /sys/devices/platform/soc/soc:hbp@0/irq_enable 1,0

on property:init.svc.plp110-hbp5=restarting
    write /sys/devices/platform/soc/soc:hbp@0/irq_enable 0,0
    write /sys/devices/platform/soc/soc:hbp@0/irq_enable 1,0
